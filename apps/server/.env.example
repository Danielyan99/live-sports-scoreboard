PORT=3000
# Get a free token at https://www.football-data.org/client/register
# Leave empty to run the simulator only.
FOOTBALL_DATA_TOKEN=
# Optional. Without it the server keeps state in memory only.
MONGO_URI=mongodb://localhost:27017/scoreboard
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
POLL_INTERVAL_MS=15000
# Simulator tick: one simulated match-minute per tick
SIM_TICK_MS=3000
# How often to refresh recent results (ms, min 5 minutes)
RESULTS_REFRESH_MS=1800000
# true = always use the simulator, even if real matches are live
FORCE_DEMO=false

# Optional. Set if MongoDB fails with "queryTxt ETIMEOUT" (some routers can't resolve mongodb+srv records).
# DNS_SERVERS=8.8.8.8,1.1.1.1
