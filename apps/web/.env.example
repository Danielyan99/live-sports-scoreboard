# Backend base URL (Socket.io connects to <url>/live)
VITE_SERVER_URL=http://localhost:3000

# Optional personal links; anything left empty is hidden in the UI.
VITE_AUTHOR_NAME=
VITE_GITHUB_URL=
VITE_PORTFOLIO_URL=

# Public URL of the deployed site, used for the link preview image (e.g. https://pitchside.vercel.app)
VITE_SITE_URL=
